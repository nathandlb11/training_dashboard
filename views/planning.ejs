<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { pageTitle: 'Planification — Training Load Dashboard' }) %>
</head>
<body>
  <%- include('partials/nav') %>

  <main class="planning-page">
    <% if (apiKeyMissing) { %>
      <div class="alert alert-info" style="margin-top:20px;">
        Renseigne <code>INTERVALS_API_KEY</code> dans le fichier <code>.env</code> à la racine du projet, puis redémarre le serveur.
      </div>
    <% } else { %>
      <% if (error) { %><div class="alert alert-error" style="margin-top:12px;"><%= error %></div><% } %>

      <div class="planning-main" id="planningLayout">

          <div id="pendingBanner" class="pending-banner" style="display:none;">
            <span id="pendingCount"></span>
            <div style="display:flex;gap:8px;align-items:center;">
              <button class="btn-ghost" id="clearPendingBtn">Tout annuler</button>
              <button id="sendPendingBtn">Envoyer à Intervals.icu</button>
            </div>
          </div>

          <div class="pmc-sticky-wrap" id="pmcStickyWrap">
            <div class="card" id="chartCard" style="padding:16px 18px;margin-bottom:0;">
              <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <h3 style="margin:0;font-size:1rem;">Charge hebdo Foster &amp; ACWR</h3>
                <button class="btn-ghost btn-sm" id="toggleChartBtn" style="font-size:0.78rem;">📉 Masquer le graphique</button>
              </div>
              <div id="chartBody">
                <div class="chart-wrap" style="height:240px;"><canvas id="pmc_chart"></canvas></div>
                <p id="cycleSummary" class="caption" style="margin:8px 0 0;"></p>
              </div>
            </div>
            <div id="sendResult" style="margin-top:10px;"></div>
          </div>

          <div class="month-nav">
            <button class="icon-btn" id="prevMonth">‹</button>
            <span id="monthLabel" class="month-label"></span>
            <button class="icon-btn" id="nextMonth">›</button>
            <button class="btn-ghost" id="todayBtn" style="margin-left:8px;font-size:0.82rem;">Aujourd'hui</button>
            <button class="btn-ghost" id="exportCsvBtn" style="margin-left:auto;font-size:0.82rem;">📥 Exporter CSV</button>
          </div>
          <div id="monthGrid"></div>
      </div>
    <% } %>
  </main>

  <!-- Modal : choisir une séance dans la bibliothèque pour l'ajouter à un jour -->
  <div id="libraryModal" class="modal-overlay">
    <div class="modal-dialog" style="width:480px;">
      <p class="modal-title">Choisir une séance</p>
      <div class="sidebar-search" style="padding:0 0 10px;">
        <input type="text" id="librarySearch" placeholder="Rechercher…" autocomplete="off" />
      </div>
      <div class="field">
        <select id="folderFilter">
          <option value="">Tous les dossiers</option>
        </select>
      </div>
      <div id="intervalsLibrary" style="max-height:45vh;overflow-y:auto;border:1px solid var(--border);border-radius:8px;">
        <div class="lib-loading"><div class="spinner"></div><span>Chargement…</span></div>
      </div>
      <div class="modal-actions" style="justify-content:space-between;">
        <button class="btn-ghost" id="librarySessionLibre">Séance libre</button>
        <button class="btn-ghost" id="libraryCancel">Annuler</button>
      </div>
    </div>
  </div>

  <!-- Modal : modifier une séance (en attente ou déjà envoyée) -->
  <div id="editModal" class="modal-overlay">
    <div class="modal-dialog">
      <p class="modal-title">Modifier la séance</p>
      <div class="field"><label>Titre</label><input type="text" id="editName" style="width:100%" /></div>
      <div class="field"><label>RPE (1–10)</label><input type="number" id="editRpe" min="1" max="10" style="width:100%" /></div>
      <div class="field">
        <label>Description (format Intervals.icu)</label>
        <textarea id="editDescription" rows="6" style="width:100%;resize:vertical;font-family:monospace;font-size:0.82rem;" placeholder="- Echauffement 15m 70-80% LTHR

3x
- 3m 100-110% FTP
- 2m 50-60% FTP

- Retour au calme 10m 50-60% LTHR"></textarea>
      </div>
      <div id="editStepChart" class="step-chart"></div>
      <p id="editComputedInfo" class="caption" style="margin:-4px 0 6px;font-weight:600;"></p>
      <p id="editRealNotice" class="caption" style="display:none;margin:-4px 0 6px;"
      <div class="modal-actions">
        <button class="btn-ghost" id="editCancel">Annuler</button>
        <button id="editSave">Enregistrer</button>
      </div>
    </div>
  </div>

  <!-- Modal : proposer une semaine via IA -->
  <div id="aiPlanModal" class="modal-overlay">
    <div class="modal-dialog">
      <p class="modal-title">Proposer une semaine via IA</p>
      <div class="field"><label for="aiPlanType">Type de semaine</label>
        <select id="aiPlanType" style="width:100%">
          <option value="Récupération">Récupération</option>
          <option value="Charge">Charge</option>
          <option value="Choc">Choc</option>
        </select>
      </div>
      <div class="field"><label for="aiPlanAcwr">ACWR cible</label><input type="number" id="aiPlanAcwr" step="0.05" min="0.3" max="2.5" style="width:100%" /></div>
      <div class="field"><label for="aiPlanComment">Commentaire pour l'IA (optionnel)</label>
        <textarea id="aiPlanComment" rows="3" style="width:100%;resize:vertical;" placeholder="Ex : semaine avant un trail technique, privilégier le dénivelé…"></textarea>
      </div>
      <div class="modal-actions">
        <button class="btn-ghost" id="aiPlanCancel">Annuler</button>
        <button id="aiPlanGenerate">Générer</button>
      </div>
    </div>
  </div>

  <!-- Modal : confirmation avant envoi à Intervals.icu -->
  <div id="confirmSendModal" class="modal-overlay">
    <div class="modal-dialog">
      <p class="modal-title">Confirmer l'envoi à Intervals.icu</p>
      <div id="confirmSendSummary"></div>
      <p class="caption" style="margin-top:10px;">Cette action va créer, modifier ou supprimer des séances directement sur Intervals.icu.</p>
      <div class="modal-actions">
        <button class="btn-ghost" id="confirmSendCancel">Annuler</button>
        <button id="confirmSendOk">✅ Confirmer l'envoi</button>
      </div>
    </div>
  </div>

  <!-- Modal : récap d'une séance passée (réalisée, manquée ou hors plan) -->
  <div id="recapModal" class="modal-overlay">
    <div class="modal-dialog">
      <p class="modal-title" id="recapTitle"></p>
      <div id="recapBody"></div>
      <div class="modal-actions" style="justify-content:space-between;">
        <button class="btn-ghost" id="recapAdvancedBtn" style="display:none;">📊 Analyse avancée</button>
        <button class="btn-ghost" id="recapClose">Fermer</button>
      </div>
    </div>
  </div>

  <!-- Modal : analyse avancée par intervalle d'une activité -->
  <div id="intervalsModal" class="modal-overlay">
    <div class="modal-dialog" style="width:min(90vw, 780px);">
      <p class="modal-title" id="intervalsTitle">Analyse avancée</p>
      <div id="intervalsBody" style="max-height:60vh;overflow:auto;"></div>
      <div class="modal-actions">
        <button class="btn-ghost" id="intervalsClose">Fermer</button>
      </div>
    </div>
  </div>

  <script>
    window.__PLANNING_BOOTSTRAP__ = <%- JSON.stringify({
      athleteId,
      chronicData,
      calendar,
      calendarStart,
      calendarEnd,
      historyStart,
      historyEnd
    }) %>;
  </script>
  <script src="/vendor/format.js"></script>
  <script src="/js/planning.js?v=<%= Date.now() %>"></script>
</body>
</html>
