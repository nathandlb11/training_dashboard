<%
  const navAthleteId = typeof athleteId !== 'undefined' ? athleteId : (typeof params !== 'undefined' && params ? params.athleteId : '');
  const navAthletes = typeof athletes !== 'undefined' ? athletes : [];
%>
<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 12 8 12 10 6 14 18 16 12 21 12"></polyline></svg>
      <span>Training Load Dashboard</span>
    </div>
    <nav class="tabs">
      <a href="/dashboard" class="tab <%= currentPath === '/dashboard' ? 'active' : '' %>">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="20" x2="4" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="20" y1="20" x2="20" y2="14"></line></svg>
        <span>Dashboard</span>
      </a>
      <a href="/planning" class="tab <%= currentPath === '/planning' ? 'active' : '' %>">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line><line x1="8" y1="3" x2="8" y2="7"></line><line x1="16" y1="3" x2="16" y2="7"></line></svg>
        <span>Planification</span>
      </a>
    </nav>
    <div class="topbar-right">
      <% if (navAthletes && navAthletes.length) { %>
        <select id="athleteSelect" class="nav-athlete-select" aria-label="Athlète">
          <% navAthletes.forEach(a => { %>
            <option value="<%= a.id %>" <%= a.id === navAthleteId ? 'selected' : '' %>><%= a.label %></option>
          <% }) %>
        </select>
      <% } %>
      <% if (typeof dashboardAuthEnabled !== 'undefined' && dashboardAuthEnabled) { %>
        <form method="POST" action="/logout" style="margin:0;">
          <button type="submit" class="btn-ghost">Déconnexion</button>
        </form>
      <% } %>
    </div>
  </div>
</header>
<script>
  (function () {
    var sel = document.getElementById('athleteSelect');
    if (!sel) return;
    sel.addEventListener('change', function () {
      localStorage.setItem('selectedAthleteId', sel.value);
    });
    // Réapplique la sélection mémorisée après que les scripts de page (dashboard.js/planning.js)
    // aient attaché leurs propres écouteurs, pour que le changement d'athlète soit bien pris en compte.
    window.addEventListener('load', function () {
      var saved = localStorage.getItem('selectedAthleteId');
      if (!saved || sel.value === saved) return;
      var hasOption = Array.prototype.some.call(sel.options, function (o) { return o.value === saved; });
      if (!hasOption) return;
      sel.value = saved;
      sel.dispatchEvent(new Event('change'));
    });
  })();
</script>
