<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { pageTitle: 'Training Load Dashboard' }) %>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <div class="dash-header">
      <div>
        <h1>Training Load Dashboard</h1>
        <p class="page-subtitle">Vue d'ensemble de la charge d'entraînement et de la forme.</p>
      </div>
    </div>

    <% if (apiKeyMissing) { %>
      <div class="alert alert-info">
        Renseigne <code>INTERVALS_API_KEY</code> dans le fichier <code>.env</code> à la racine du projet
        (Settings → Developer Settings → API Key sur Intervals.icu), puis redémarre le serveur.
      </div>
    <% } else if (error) { %>
      <div class="alert alert-error">Impossible de récupérer les données Intervals.icu : <%= error %></div>
    <% } else if (bootstrapData && bootstrapData.empty) { %>
      <div class="alert alert-warning"><%= bootstrapData.message %></div>
    <% } %>

    <% if (!apiKeyMissing && !error) { %>
      <div class="toolbar" id="filters-card">
        <div class="field">
          <label for="historyStart">Début d'analyse</label>
          <input type="date" id="historyStart" value="<%= params.historyStart %>" />
        </div>
        <button type="button" class="btn-ghost" id="toggleNotesBtn" style="display:none;">🗒️ Afficher les notes</button>
        <button type="button" class="btn-ghost" id="exportCsvBtn">📥 Exporter CSV</button>
      </div>

      <div id="dashboard-content"></div>
    <% } %>
  </main>

  <script>
    window.__BOOTSTRAP__ = <%- JSON.stringify({ params, data: bootstrapData, widgetToken: typeof widgetToken !== 'undefined' ? widgetToken : '' }) %>;
  </script>
  <script src="/vendor/format.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
