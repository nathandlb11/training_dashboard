# Clé API Intervals.icu (Settings → Developer Settings → API Key)
INTERVALS_API_KEY=

# Port du serveur Express (optionnel, ignoré sur Vercel)
PORT=3000

# Fournisseur IA pour le planificateur : anthropic | groq | ollama
AI_PROVIDER=groq
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optionnel : si défini, /api/dashboard-data exige ?token=<valeur> (utilisé par le widget iOS)
WIDGET_TOKEN=
